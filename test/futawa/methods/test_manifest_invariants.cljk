(ns futawa.methods.test-manifest-invariants
  "futawa — manifest invariants (ported; reads manifest.edn blob, jsonld retired)."
  (:require [kotoba.io :as kio] [kotoba.test :refer [deftest is run-tests]]
            [kotoba.lang.text :as str] [kotoba.lang.edn :as edn]))
(def ^:private actor-dir (kio/file "."))
(def ^:private lexdir (kio/file actor-dir "wire/lex"))
(defn- manifest [] (:actor/manifest (edn/read-string (slurp (kio/file actor-dir "manifest.edn")))))
(defn- on-disk [] (->> (kio/list-files lexdir) (map #(kio/file-name %)) (filter #(str/ends-with? % ".json")) (map #(subs % 0 (- (count %) 5))) set))
(deftest manifest-namespaces-match-disk
  (let [m (manifest)
        declared (set (map #(last (str/split % #"\.")) (or (get m "lexiconNamespaces") (get m "lexicons") [])))]
    (is (= declared (on-disk)))))
(deftest did
  (is (= (get (manifest) "id") "did:web:etzhayyim.com:futawa")))
(defn -main [& _] (let [r (run-tests 'futawa.methods.test-manifest-invariants)] (System/exit (if (zero? (+ (:fail r) (:error r))) 0 1))))
