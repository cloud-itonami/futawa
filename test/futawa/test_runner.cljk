(ns futawa.test-runner
  (:require [kotoba.io :as io] [kotoba.test :as test]))
(defn- file-ns [f]
  (with-open [r (java.io.PushbackReader. (io/reader f))]
    (second (read {:read-cond :allow :features #{:clj}} r))))
(defn -main [& _]
  (let [fs (->> (io/file-seq (io/file "test/futawa"))
                (filter #(io/file? %))
                (filter #(re-find #"\.clj(c)?$" (io/file-name %)))
                (remove #(= "test_runner.clj" (io/file-name %)))
                (sort-by str))
        nss (mapv file-ns fs)]
    (doseq [f fs] (load-file (str f)))
    (let [{:keys [fail error]} (apply test/run-tests nss)]
      (shutdown-agents)
      (when (pos? (+ fail error)) (System/exit 1)))))
